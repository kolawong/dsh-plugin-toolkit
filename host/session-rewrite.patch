@@ -0,0 +1,118 @@
+/**
+ * Agent-loop journaling of an in-place edit rewrite (`source.origin === 'edit'`).
+ * The rewrite RPC only validates and delivers; the loop owns the surface
+ * `replace` that rewinds the derived model history. These cases pin both halves:
+ * the journaled replacement event and the request the next turn actually sends.
+ */
+
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry, { type Agent } from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import LlmRuntime, { type GenerateOptions } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import { MockAdapter, textResponse } from './mock-adapter.ts'
+
+async function harness(adapter: MockAdapter): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  ctx.llm.registerAdapter(['mock'], adapter)
+  return ctx
+}
+
+function send(agent: Agent, text: string): void {
+  agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }))
+}
+
+/** Every text block a captured request carried, in order. */
+function requestText(request: GenerateOptions): string[] {
+  const out: string[] = []
+  for (const message of request.messages) {
+    const content = message.content as readonly { readonly type?: string; readonly text?: string }[]
+    for (const block of content) {
+      if (block.type === 'text' && typeof block.text === 'string') out.push(block.text)
+    }
+  }
+  return out
+}
+
+describe('Agent edit rewrite', () => {
+  it('journals the replacement as a surface replace and rewinds the request history', async () => {
+    const adapter = new MockAdapter([textResponse('first answer'), textResponse('second answer')])
+    const ctx = await harness(adapter)
+    const agent = await ctx.agentLoop.create(SessionId('rewrite'), { provider: 'mock', model: 'mock' })
+
+    send(agent, 'original question')
+    await agent.whenIdle()
+    const original = agent.session.snapshotEvents().findLast(
+      event => event.type === 'user/message' && event.data.source.kind === 'user',
+    )
+    if (original === undefined) throw new Error('first turn journaled no user message')
+    const tailEnd = agent.session.surface.nodes.at(-1)
+
+    agent.followup(createUserMessage({
+      content: [{ type: 'text', text: 'edited question' }],
+      source: { kind: 'user', origin: 'edit', rewriteSeq: original.seq },
+    }))
+    await agent.whenIdle()
+
+    // The journaled replacement is a surface replace from the edited message to
+    // the consumed tail, carrying origin: 'edit'.
+    const replacement = agent.session.snapshotEvents().findLast(event => event.type === 'user/message')
+    expect(replacement?.type === 'user/message' && replacement.surfaceOp).toMatchObject({
+      op: 'replace',
+      startSeq: original.seq,
+      endSeq: tailEnd,
+    })
+    expect(replacement?.data.source).toMatchObject({ origin: 'edit', rewriteSeq: original.seq })
+
+    // The next request's derived history equals "the user always sent the edit":
+    // the old question and the first answer it consumed are gone.
+    expect(adapter.requests).toHaveLength(2)
+    const history = requestText(adapter.requests[1]!)
+    expect(history).toContain('edited question')
+    expect(history).not.toContain('original question')
+    expect(history).not.toContain('first answer')
+  })
+
+  it('appends an ordinary followup after a rewrite normally', async () => {
+    const adapter = new MockAdapter([
+      textResponse('first answer'),
+      textResponse('second answer'),
+      textResponse('third answer'),
+    ])
+    const ctx = await harness(adapter)
+    const agent = await ctx.agentLoop.create(SessionId('rewrite-then-send'), { provider: 'mock', model: 'mock' })
+
+    send(agent, 'original question')
+    await agent.whenIdle()
+    const original = agent.session.snapshotEvents().findLast(
+      event => event.type === 'user/message' && event.data.source.kind === 'user',
+    )
+    if (original === undefined) throw new Error('first turn journaled no user message')
+    agent.followup(createUserMessage({
+      content: [{ type: 'text', text: 'edited question' }],
+      source: { kind: 'user', origin: 'edit', rewriteSeq: original.seq },
+    }))
+    await agent.whenIdle()
+
+    send(agent, 'follow-up question')
+    await agent.whenIdle()
+
+    const appended = agent.session.snapshotEvents().findLast(event => event.type === 'user/message')
+    expect(appended?.type === 'user/message' && appended.surfaceOp).toBe('append')
+    const history = requestText(adapter.requests[2]!)
+    expect(history).toEqual(expect.arrayContaining(['edited question', 'follow-up question']))
+    expect(history).not.toContain('original question')
+  })
+})

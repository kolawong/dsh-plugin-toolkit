+++ b/packages/api/session-controller/tests/session-rewrite.host.spec.ts
@@ -0,0 +1,169 @@
+/**
+ * Session Controller rewrite (edit-the-last-user-message-and-resend) validation.
+ * The controller only validates and delivers: the replacement message enters the
+ * Agent inbox carrying `source.origin: 'edit'` plus the target seq, and the loop
+ * journals it as a surface `replace`. These cases own the rejection vocabulary
+ * and the delivered message's shape; agent-loop.spec owns the journaling.
+ */
+
+import { describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SessionStore from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import type { Agent, CreateAgentOptions } from '@deepseek-ai/dsh-agent'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { createSessionTestRemote } from './test-remote.ts'
+
+const sid = (id: string): SessionId => id as SessionId
+
+/** Compose the session/projection/agent services the controller resolves through. */
+async function composed(): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(AgentRegistry)
+  ctx.agents.setFactory({
+    createAgent: (_ownerCtx: Context, options: CreateAgentOptions) => {
+      const session = ctx.sessions.create(options.sessionId)
+      return Promise.resolve({
+        agent: { id: session.id, session, status: 'idle', ctx } as Agent,
+        dispose: () => Promise.resolve(),
+      })
+    },
+    resume: () => Promise.reject(new Error('resume must not run: every source is attached')),
+  })
+  return ctx
+}
+
+/**
+ * Register one live agent whose log holds `turns` completed human turns, with a
+ * `followup` spy standing in for inbox delivery.
+ */
+async function liveAgent(
+  ctx: Context,
+  id: string,
+  turns: number,
+  status: 'idle' | 'running' = 'idle',
+): Promise<{ readonly session: Session; readonly followup: ReturnType<typeof vi.fn> }> {
+  const session = ctx.sessions.create(sid(id), { meta: { cwd: '/proj' } })
+  for (let turn = 1; turn <= turns; turn++) {
+    session.append('turn/start', { turn })
+    session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: `prompt ${String(turn)}` }],
+      source: { kind: 'user' },
+    }), { surfaceOp: 'append' })
+    session.append('turn/end', { turn, reason: { kind: 'completed' } })
+  }
+  const followup = vi.fn()
+  await ctx.agents.register({ id: session.id, session, status, ctx, followup } as unknown as Agent)
+  return { session, followup }
+}
+
+function lastHumanSeq(session: Session): number {
+  const event = session.snapshotEvents().findLast(
+    item => item.type === 'user/message' && item.data.source.kind === 'user',
+  )
+  if (event === undefined) throw new Error('fixture has no human user message')
+  return event.seq
+}
+
+const remote = (ctx: Context) => createSessionTestRemote(ctx, {
+  defaultModelSelection: () => ({ provider: 'p', model: 'm' }),
+  cwd: '/tmp',
+})
+
+describe('sessions.rewrite', () => {
+  it('delivers a replacement edit message targeting the last human user message', async () => {
+    const ctx = await composed()
+    const { session, followup } = await liveAgent(ctx, 'session-rewrite', 2)
+    const target = lastHumanSeq(session)
+
+    const response = await remote(ctx).rewrite({
+      sessionId: session.id,
+      messageSeq: target,
+      content: [{ type: 'text', text: 'edited prompt' }],
+    })
+
+    expect(response.ok).toBe(true)
+    expect(followup).toHaveBeenCalledTimes(1)
+    const delivered = followup.mock.calls[0]?.[0] as { content: unknown; source: unknown }
+    expect(delivered.content).toEqual([{ type: 'text', text: 'edited prompt' }])
+    expect(delivered.source).toMatchObject({ kind: 'user', origin: 'edit', rewriteSeq: target })
+  })
+
+  it('rejects a target that is not the last human user message', async () => {
+    const ctx = await composed()
+    const { session, followup } = await liveAgent(ctx, 'session-rewrite-not-last', 2)
+    const firstTurn = session.snapshotEvents().find(
+      item => item.type === 'user/message' && item.data.source.kind === 'user',
+    )
+    if (firstTurn === undefined) throw new Error('fixture has no first user message')
+
+    const response = await remote(ctx).rewrite({
+      sessionId: session.id,
+      messageSeq: firstTurn.seq,
+      content: [{ type: 'text', text: 'edited' }],
+    })
+
+    expect(response.ok).toBe(false)
+    if (!response.ok) {
+      expect(response.error).toMatchObject({
+        code: 'session/rewrite-unavailable',
+        details: { sessionId: session.id, messageSeq: firstTurn.seq },
+      })
+    }
+    expect(followup).not.toHaveBeenCalled()
+  })
+
+  it('rejects a running session with agent-busy', async () => {
+    const ctx = await composed()
+    const { session, followup } = await liveAgent(ctx, 'session-rewrite-busy', 1, 'running')
+
+    const response = await remote(ctx).rewrite({
+      sessionId: session.id,
+      messageSeq: lastHumanSeq(session),
+      content: [{ type: 'text', text: 'edited' }],
+    })
+
+    expect(response.ok).toBe(false)
+    if (!response.ok) expect(response.error.code).toBe('session/agent-busy')
+    expect(followup).not.toHaveBeenCalled()
+  })
+
+  it('rejects non-text replacement content with the rewrite reason', async () => {
+    const ctx = await composed()
+    const { session, followup } = await liveAgent(ctx, 'session-rewrite-image', 1)
+
+    const response = await remote(ctx).rewrite({
+      sessionId: session.id,
+      messageSeq: lastHumanSeq(session),
+      content: [{ type: 'image', mediaType: 'image/png', data: 'YQ==' }],
+    })
+
+    expect(response.ok).toBe(false)
+    if (!response.ok) {
+      expect(response.error).toMatchObject({
+        code: 'session/attachment-invalid',
+        details: { reason: 'REWRITE_NON_TEXT' },
+      })
+    }
+    expect(followup).not.toHaveBeenCalled()
+  })
+
+  it('rejects whitespace-only replacement text as a bad request', async () => {
+    const ctx = await composed()
+    const { session, followup } = await liveAgent(ctx, 'session-rewrite-blank', 1)
+
+    const response = await remote(ctx).rewrite({
+      sessionId: session.id,
+      messageSeq: lastHumanSeq(session),
+      content: [{ type: 'text', text: '   ' }],
+    })
+
+    expect(response.ok).toBe(false)
+    if (!response.ok) expect(response.error.code).toBe('gateway/bad-request')
+    expect(followup).not.toHaveBeenCalled()
+  })
+})
